{
  "name": "@tasktrove/calendar-sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "pro": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": "./src/types.ts",
    "./ics": "./src/ics.ts",
    "./adapter": "./src/adapter.ts",
    "./service": "./src/service.ts",
    "./store": "./src/store.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck:base": "tsgo --noEmit",
