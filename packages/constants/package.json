{
  "name": "@tasktrove/constants",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "pro": "./src/defaults.pro.ts",
      "default": "./src/defaults.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck:base": "tsgo --noEmit",
    "typecheck:pro": "tsgo --project tsconfig.pro.json --noEmit",
    "typecheck": "pnpm typecheck:base && node ../../scripts/run-pro-if-present.mjs tsconfig.pro.json pnpm typecheck:pro",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "check:pro": "pnpm typecheck:pro && pnpm lint",
    "test": "node ../../scripts/run-vitest.mjs run",
    "test:watch": "node ../../scripts/run-vitest.mjs --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
