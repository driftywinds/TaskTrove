{
  "name": "@tasktrove/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./defaults": {
      "pro": "./src/defaults.ts",
      "default": "./src/defaults.ts"
    },
    "./defaults.base": "./src/defaults.ts",
    "./utils": {
      "pro": "./src/utils.ts",
      "default": "./src/utils.ts"
    },
    "./test-constants": {
      "pro": "./src/test-constants.ts",
      "default": "./src/test-constants.ts"
    },
    "./id": {
      "pro": "./src/id.ts",
      "default": "./src/id.ts"
    },
    "./constants": {
      "pro": "./src/constants.ts",
      "default": "./src/constants.ts"
    },
    "./validators": {
      "pro": "./src/validators.ts",
      "default": "./src/validators.ts"
    },
    "./core": {
      "pro": "./src/core.ts",
      "default": "./src/core.ts"
    },
    "./core.pro": "./src/core.pro.ts",
    "./group": "./src/group.ts",
    "./settings": {
      "pro": "./src/settings.ts",
      "default": "./src/settings.ts"
    },
    "./serialization": {
      "pro": "./src/serialization.ts",
      "default": "./src/serialization.ts"
    },
    "./api-requests": {
      "pro": "./src/api-requests.ts",
      "default": "./src/api-requests.ts"
    },
    "./api-responses": {
      "pro": "./src/api-responses.ts",
      "default": "./src/api-responses.ts"
    },
    "./data-file": {
      "pro": "./src/data-file.ts",
      "default": "./src/data-file.ts"
    },
    "./data-file.base": "./src/data-file.ts",
    "./analytics": "./src/analytics.ts",
    "./calendar": "./src/calendar.ts",
    "./notifications": "./src/notifications.ts",
    "./voice-commands": "./src/voice-commands.ts",
    "./api-errors": "./src/api-errors.ts",
    "./rewards": {
      "pro": "./src/rewards.ts",
      "default": "./src/rewards.ts"
    },
    "./reward-levels": {
      "pro": "./src/reward-levels.ts",
      "default": "./src/reward-levels.ts"
    },
    "./schema-version": "./src/schema-version.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck:base": "tsgo --noEmit",
    "typecheck:pro": "tsgo --project tsconfig.pro.json --noEmit",
    "typecheck": "pnpm typecheck:base && node ../../scripts/run-pro-if-present.mjs tsconfig.pro.json pnpm typecheck:pro",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "check:pro": "pnpm typecheck:pro && pnpm lint && pnpm test:pro",
    "test:base": "node ../../scripts/run-vitest.mjs run --config vitest.config.ts",
    "test:pro": "node ../../scripts/run-vitest.mjs run --config vitest.config.pro.ts",
    "test": "pnpm test:base && node ../../scripts/run-pro-if-present.mjs vitest.config.pro.ts pnpm test:pro",
    "test:watch": "node ../../scripts/run-vitest.mjs --watch",
    "test:watch:pro": "node ../../scripts/run-vitest.mjs --watch --config vitest.config.pro.ts"
  },
  "dependencies": {
    "zod": "catalog:",
    "date-fns": "latest",
    "uuid": "catalog:",
    "@tasktrove/constants": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@typescript/native-preview": "catalog:",
    "@types/uuid": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
