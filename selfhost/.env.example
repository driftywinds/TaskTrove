# Staging environment for docker-compose.staging.yml
#
# Copy this file to `.env` next to the compose file and edit it:
#   cp .env.example .env
#
# `.env` is git-ignored; this example file is safe to commit.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED to enable login (web multi-user auth + mobile-app tokens).
# Generate a strong value with:
#   openssl rand -base64 32
# Leave EMPTY for an open, single-user instance (auth disabled) — handy for a
# quick local test, not recommended if the instance is reachable from a network.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Container timezone. The nightly backup scheduler (default 02:00) runs in
# this timezone. Examples: UTC, America/New_York, Europe/Berlin, Asia/Kolkata
TZ=UTC

# ---------------------------------------------------------------------------
# Optional switches
# ---------------------------------------------------------------------------
# Halloween theme override:
# ENABLE_HALLOWEEN_THEME=true
# Debug logging:
# DEBUG=true

# ---------------------------------------------------------------------------
# docker-compose.staging.yml overrides (uncomment to change defaults)
# ---------------------------------------------------------------------------
# Pull a specific immutable build instead of :edge:
# TASKTROVE_IMAGE=ghcr.io/driftywinds/tasktrove:sha-000000000000
# Host on a different port:
# TASKTROVE_PORT=3000
